{
  "name": "@alexeiled/pi-plan-exec",
  "version": "1.8.0",
  "description": "Turn a Markdown execution plan into an isolated, resumable Pi run - durable controller state, one writer, deliberate recovery",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-command",
    "pi-skill",
    "plan-execution",
    "ralphex"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexei-led/pi-plan-exec.git"
  },
  "homepage": "https://github.com/alexei-led/pi-plan-exec#readme",
  "bugs": {
    "url": "https://github.com/alexei-led/pi-plan-exec/issues"
  },
  "type": "module",
  "packageManager": "npm@12.0.2",
  "main": "./src/index.ts",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src/*.ts",
    "src/*.mjs",
    "skills/exec-plan"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "tsc": "tsc --noEmit",
    "test": "vitest run && node --import jiti/register --test test/index.test.ts",
    "test:runtime-smoke": "node --test test/autonomous-runtime-smoke.mjs",
    "check": "biome check --error-on-warnings . && npm run tsc",
    "lint": "biome lint --error-on-warnings .",
    "lint:fix": "biome lint --write --error-on-warnings .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "pack:dry": "node scripts/check-pack.mjs",
    "publish:dry": "npm publish --dry-run",
    "test:all": "npm run check && npm test && npm run test:runtime-smoke && npm run test:native-recovery && npm run test:parent-death && npm run test:packed-consumer && npm run pack:dry",
    "test:native-recovery": "node --test test/native-recovery-smoke.mjs",
    "test:packed-consumer": "node --test test/packed-consumer-smoke.mjs",
    "test:parent-death": "node --test test/native-parent-death-smoke.mjs",
    "test:native-contracts": "vitest run test/native-runtime-contract.test.ts test/native-runtime.test.ts test/operation-safety.test.ts test/rollback-preflight.test.ts",
    "check:rollback": "node src/rollback-preflight.mjs"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "image": "https://raw.githubusercontent.com/alexei-led/pi-plan-exec/main/assets/plan-exec-card.png"
  },
  "peerDependencies": {
    "@alexeiled/pi-fusion": ">=0.9.3 <1.0.0",
    "@earendil-works/pi-coding-agent": "^1.0.4",
    "@earendil-works/pi-tui": "*",
    "pi-subagents": ">=0.76.1 <0.77.0",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "pi-subagents": {
      "optional": true
    },
    "@alexeiled/pi-fusion": {
      "optional": true
    }
  },
  "devDependencies": {
    "@alexeiled/pi-fusion": "^0.9.3",
    "@biomejs/biome": "2.5.14",
    "@earendil-works/pi-coding-agent": "^1.0.4",
    "@types/node": "^24.10.0",
    "jiti": "^2.7.0",
    "pi-subagents": "^0.76.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
