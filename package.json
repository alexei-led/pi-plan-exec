{
  "name": "@alexeiled/pi-plan-exec",
  "version": "1.4.1",
  "description": "Turn a Markdown execution plan into an isolated, resumable Pi run - durable controller state, one writer, deliberate recovery",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-command",
    "pi-skill",
    "plan-execution",
    "ralphex"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexei-led/pi-plan-exec.git"
  },
  "homepage": "https://github.com/alexei-led/pi-plan-exec#readme",
  "bugs": {
    "url": "https://github.com/alexei-led/pi-plan-exec/issues"
  },
  "type": "module",
  "packageManager": "npm@12.0.2",
  "main": "./src/index.ts",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src/*.ts",
    "src/*.mjs",
    "skills/exec-plan"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import jiti/register --test test/*.test.ts",
    "test:runtime-smoke": "node --test test/autonomous-runtime-smoke.mjs",
    "lint": "eslint . --cache --cache-strategy content",
    "pack:dry": "node scripts/check-pack.mjs",
    "test:all": "npm run lint && npm run check && npm test && npm run pack:dry"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "image": "https://raw.githubusercontent.com/alexei-led/pi-plan-exec/main/assets/plan-exec-card.png"
  },
  "peerDependencies": {
    "@alexeiled/pi-fusion": ">=0.7.0",
    "@alexeiled/pi-subagents-bridge": ">=0.3.0",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@tintinweb/pi-tasks": ">=0.9.0",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@alexeiled/pi-fusion": {
      "optional": true
    },
    "@alexeiled/pi-subagents-bridge": {
      "optional": true
    },
    "@tintinweb/pi-tasks": {
      "optional": true
    }
  },
  "dependencies": {
    "pi-subagents": "git+https://github.com/alexei-led/pi-subagents-codex-fix.git#798b70d8c94befd7ae96fc40d4ae9198a71810ef"
  },
  "devDependencies": {
    "@alexeiled/pi-fusion": "git+https://github.com/alexei-led/pi-fusion.git#5b41a651b25c86e6164b1484f4371702b63faa34",
    "@alexeiled/pi-subagents-bridge": "git+https://github.com/alexei-led/pi-subagents-bridge.git#c7ab396b2ab3f5354790c974abce41e04fea41a1",
    "@earendil-works/pi-coding-agent": "0.86.1",
    "@eslint/js": "^10.0.1",
    "@tintinweb/pi-tasks": "0.9.0",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1"
  }
}
